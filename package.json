{
    "name": "@coinstats/coinstats-mcp",
    "version": "2.0.0",
    "description": "MCP server for CoinStats API integration — stdio CLI + Cloudflare Worker",
    "main": "dist/index.js",
    "bin": {
        "coinstats-mcp": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "coinstats",
        "crypto",
        "api",
        "mcp",
        "model context protocol",
        "ai",
        "mcp server",
        "coinstats mcp",
        "cloudflare workers"
    ],
    "author": "CoinStats",
    "license": "MIT",
    "scripts": {
        "build": "npm i && npm run build:types && npm run build:js && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
        "build:js": "tsc",
        "build:types": "tsc --emitDeclarationOnly",
        "test": "node --test test/*.test.mjs",
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "tail": "wrangler tail"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "zod": "^3.24.2",
        "zod-to-json-schema": "^3.24.5"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261018.1",
        "@types/node": "^22.20.5",
        "typescript": "^5.9.3",
        "wrangler": "^4.151.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CoinStatsHQ/coinstats-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/CoinStatsHQ/coinstats-mcp/issues"
    },
    "homepage": "https://github.com/CoinStatsHQ/coinstats-mcp#readme"
}
